# TaxMitra server — environment
# Copy to .env (never commit .env) or paste these into your host's dashboard.
# Every value below is read by server/index.js; nothing is hardcoded.

# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Where the SQLite database (or the JSON fallback) lives.
DATA_DIR=./data
# openssl rand -hex 32   ← 64 hex characters
JWT_SECRET=
SESSION_DAYS=30
# Extra origins allowed to call /api from another domain (GitHub Pages, etc.)
# ALLOWED_ORIGINS=https://abhishekagrahari307-max.github.io
ADMIN_EMAILS=

# ── Email (verification + password reset) ──────────────────────────────
# console = print links to the server log (dev/tests only)
# resend  = https://resend.com  (free tier)  → EMAIL_API_KEY=re_...
# brevo   = https://brevo.com   (free tier)  → EMAIL_API_KEY=xkeysib-...
# smtp    = any relay, e.g. Gmail app password on smtp.gmail.com:587
EMAIL_DRIVER=console
EMAIL_FROM=TaxMitra <no-reply@yourdomain.in>
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASS=
SMTP_AUTH=LOGIN
VERIFY_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=30

# ── OAuth sign-in (optional) ───────────────────────────────────────────
# The public origin of THIS server; the callback is <OAUTH_BASE_URL>/api/auth/oauth/<provider>/callback
OAUTH_BASE_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Abuse limits ───────────────────────────────────────────────────────
REGISTER_PER_HOUR=10
LOGIN_PER_15MIN=20
FORGOT_PER_HOUR=10
API_PER_MINUTE=600
# Require a confirmed email before cloud sync/upload (default off; local tools always work)
REQUIRE_VERIFIED_EMAIL=false

# ── AI (server-side keys: visitors need none) ───────────────────────────
# Any one of these is enough. Gemini is tried first, then OpenRouter, Groq, OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For any OpenAI-compatible gateway (Together, Fireworks, Ollama, vLLM…)
OPENAI_BASE_URL=https://api.openai.com/v1
AI_PER_HOUR_PER_IP=40
AI_PER_DAY_GLOBAL=2000
AI_MAX_TOKENS=2048

# ── GSTN / IRP (e-invoice) ──────────────────────────────────────────────
# Only fill these when you actually hold credentials. Without them the
# endpoints answer 501 GOVT_NOT_CONFIGURED — they never simulate a filing.
IRP_ENV=sandbox
GSTN_CLIENT_ID=
GSTN_CLIENT_SECRET=
# GSTIN of the registered business that owns the credentials
GSTN_USERNAME=
GSTN_PASSWORD=
# IRP_BASE_SANDBOX=https://einv-apisandbox.nic.in
# IRP_BASE_PROD=https://api.einvoice1.gst.gov.in

# ── GSP (GST returns) ───────────────────────────────────────────────────
GSP_ENV=sandbox
# GSP_BASE_SANDBOX=https://gsp.adaequare.com/test
# GSP_BASE_PROD=https://gsp.adaequare.com

# ── Diagnostics ─────────────────────────────────────────────────────────
LOG_REQUESTS=0
