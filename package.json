{
  "name": "taxmitra",
  "version": "11.2.0",
  "private": true,
  "description": "TaxMitra - GST billing, income-tax and ITR preparation tools, local-first in the browser, with a real Node server for accounts, sync and AI.",
  "license": "SEE LICENSE IN README.md",
  "scripts": {
    "test": "node tests/run.js",
    "test:gst": "node tests/run.js gst",
    "test:tax": "node tests/run.js income-tax",
    "test:pages": "node tests/run.js pages",
    "serve": "node server/index.js",
    "test:load": "node tests/pages-load.js",
    "test:handlers": "node tests/run.js handlers",
    "start": "node server/index.js",
    "serve:python": "python3 -m http.server 8080",
    "test:server": "node --test server/test/otp.test.js server/test/server.test.js",
    "test:all": "node tests/run.js && node --test server/test/otp.test.js server/test/server.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "gst",
    "itr",
    "income-tax",
    "invoicing",
    "india",
    "offline-first"
  ]
}
