# =====================================================
# TaxMitra AI Enterprise – Environment Variables
# Copy this file to .env and fill in your values
# =====================================================

# ─── Server ───────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://taxmitra:password@localhost:5432/taxmitra_db"
DB_POOL_SIZE=10

# ─── Redis Cache ──────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=300

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# ─── Firebase ─────────────────────────────────────────
# Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Firebase Web Config (for frontend SDK)
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# ─── AI APIs ──────────────────────────────────────────
# Gemini (FREE tier: 15 RPM) – https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# OpenAI (paid) – https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Primary AI provider: gemini | openai | rule-based
AI_PRIMARY_PROVIDER=gemini
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# ─── Email (SMTP) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=TaxMitra AI <noreply@taxmitra.ai>

# ─── SMS (Twilio) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE=+1234567890

# ─── File Storage ─────────────────────────────────────
STORAGE_PROVIDER=local
LOCAL_UPLOAD_PATH=./uploads

# AWS S3 (optional – for production)
AWS_S3_BUCKET=taxmitra-documents
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Payment Gateway ──────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# ─── Rate Limiting ────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
